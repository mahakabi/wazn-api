# --- App ---
NODE_ENV=development
PORT=3000
# Comma-separated origins allowed by CORS (gym portal / admin web)
CORS_ORIGINS=http://localhost:3001

# --- Data (matches docker-compose.yml) ---
DATABASE_URL=postgresql://wazn:wazn@localhost:5433/wazn?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
# HMAC key for OTP codes stored in Redis
OTP_SECRET=change-me-otp-secret-min-32-characters

# --- Email (OTP). Defaults = Mailpit from docker-compose; open http://localhost:8025 ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Wazn <no-reply@wazn.local>"

# --- External providers (filled in later milestones) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
GOOGLE_MAPS_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_KEY=
S3_SECRET=
LLM_API_KEY=

# --- Seed ---
# Email of the seeded admin user (sign in with it)
SEED_ADMIN_EMAIL=admin@wazn.local
