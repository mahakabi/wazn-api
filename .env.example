# --- App ---
NODE_ENV=development
PORT=3000
# Comma-separated origins allowed by CORS (gym portal / admin web)
CORS_ORIGINS=http://localhost:3001

# --- Data (matches docker-compose.yml) ---
DATABASE_URL=postgresql://wazn:wazn@localhost:5432/wazn?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# --- External providers (filled in later milestones) ---
SMS_PROVIDER_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
GOOGLE_MAPS_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_KEY=
S3_SECRET=
LLM_API_KEY=

# --- Seed ---
# E.164 phone for the seeded admin user
SEED_ADMIN_PHONE=+966500000001
